{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/chip.schema.json",
  "title": "ChipDefinition",
  "type": "object",
  "required": ["chipId", "name", "package", "image", "viewBox", "pins"],
  "properties": {
    "chipId": { "type": "string" },
    "name": { "type": "string" },
    "package": { "type": "string" },
    "datasheetUrl": { "type": "string", "format": "uri" },
    "image": { "type": "string" },
    "viewBox": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "number", "name", "position", "functions"],
        "properties": {
          "id": { "type": "string" },
          "number": { "type": "string" },
          "name": { "type": "string" },
          "position": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          },
          "area": {
            "type": "object",
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "w": { "type": "number", "exclusiveMinimum": 0 },
              "h": { "type": "number", "exclusiveMinimum": 0 }
            },
            "additionalProperties": false
          },
          "functions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": { "type": "string" },
                "role": { "type": "string" },
                "notes": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "electrical": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "voltage": { "type": "string" }
            },
            "additionalProperties": false
          },
          "reserved": {
            "type": "object",
            "required": ["level"],
            "properties": {
              "level": { "enum": ["info", "warn", "error"] },
              "tags": { "type": "array", "items": { "type": "string" } },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

